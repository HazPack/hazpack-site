{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/portal(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/portal-(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/portal-purge",
      "schedule": "15 11 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/styles.css",
      "destination": "/assets/styles.css",
      "permanent": true
    },
    {
      "source": "/script.js",
      "destination": "/assets/script.js",
      "permanent": true
    },
    {
      "source": "/logo.png",
      "destination": "/assets/logo.png",
      "permanent": true
    },
    {
      "source": "/logo.svg",
      "destination": "/assets/logo.svg",
      "permanent": true
    },
    {
      "source": "/favicon.svg",
      "destination": "/assets/favicon.svg",
      "permanent": true
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/assets/apple-touch-icon.png",
      "permanent": true
    }
  ]
}
